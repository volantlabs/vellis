{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sysml-evolution:schema:1.0",
  "title": "Model and implementation evolution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evolution",
    "baselines",
    "scope",
    "findings",
    "decisions",
    "work_items",
    "reviews",
    "closure"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evolution": {
      "$ref": "#/$defs/evolution"
    },
    "baselines": {
      "$ref": "#/$defs/baselines"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/work_item"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "closure": {
      "$ref": "#/$defs/closure"
    }
  },
  "anyOf": [
    {
      "properties": {
        "findings": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "decisions": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "short_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "reference_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 400
    },
    "status": {
      "enum": [
        "not applicable",
        "not evaluated",
        "absent",
        "partial",
        "conforming",
        "conflicting"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "implementation",
        "language",
        "execution_environment",
        "checkpoint"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/nonempty_string"
        },
        "implementation": {
          "$ref": "#/$defs/nonempty_string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "execution_environment": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "nullable_baseline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/baseline"
        }
      ]
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/baseline"
        },
        "target": {
          "$ref": "#/$defs/nullable_baseline"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "checkpoint"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-required",
            "pending",
            "accepted",
            "changes-required"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "summary",
        "finding_ids",
        "evidence_refs"
      ],
      "properties": {
        "classification": {
          "enum": [
            "language question",
            "model gap",
            "plan gap",
            "feasibility consequence",
            "stale baseline",
            "external dependency"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "finding_ids": {
          "$ref": "#/$defs/id_list"
        },
        "evidence_refs": {
          "$ref": "#/$defs/reference_list"
        }
      }
    },
    "nullable_blocker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/blocker"
        }
      ]
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "objective",
        "observable_distinction",
        "lifecycle",
        "approval",
        "blocker",
        "checkpoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "mode": {
          "enum": [
            "copilot",
            "autonomous"
          ]
        },
        "objective": {
          "$ref": "#/$defs/short_string"
        },
        "observable_distinction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "lifecycle": {
          "enum": [
            "discovery",
            "planning",
            "awaiting-approval",
            "ready",
            "active",
            "blocked",
            "stale",
            "complete"
          ]
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "blocker": {
          "$ref": "#/$defs/nullable_blocker"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scope",
        "implementation_scope",
        "review_lenses",
        "non_goals"
      ],
      "properties": {
        "authority_scope": {
          "$ref": "#/$defs/reference_list"
        },
        "implementation_scope": {
          "$ref": "#/$defs/reference_list"
        },
        "review_lenses": {
          "$ref": "#/$defs/reference_list"
        },
        "non_goals": {
          "$ref": "#/$defs/reference_list"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "classification",
        "consequence",
        "authority_refs",
        "evidence_refs",
        "disposition",
        "owner_work_item_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "$ref": "#/$defs/short_string"
        },
        "classification": {
          "enum": [
            "language question",
            "model gap",
            "plan gap",
            "feasibility consequence",
            "implementation defect",
            "realization decision",
            "stale baseline",
            "external dependency",
            "out of scope"
          ]
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "authority_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "evidence_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "disposition": {
          "enum": [
            "open",
            "model-change",
            "plan-change",
            "implementation-work",
            "accepted",
            "out-of-scope",
            "resolved"
          ]
        },
        "owner_work_item_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "authority_refs",
        "alternatives",
        "reversible",
        "owner_work_item_id",
        "implementation_status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "$ref": "#/$defs/short_string"
        },
        "authority_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "alternatives": {
          "$ref": "#/$defs/reference_list"
        },
        "reversible": {
          "type": "boolean"
        },
        "owner_work_item_id": {
          "$ref": "#/$defs/id"
        },
        "implementation_status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "$ref": "#/$defs/reference_list"
        }
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "dependencies",
        "finding_ids",
        "decision_ids",
        "authority_refs",
        "acceptance",
        "compatibility_effect",
        "non_effects",
        "lifecycle",
        "implementation_status",
        "evidence_refs",
        "blocker",
        "checkpoint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/short_string"
        },
        "kind": {
          "enum": [
            "modeling",
            "implementation",
            "integration",
            "closure"
          ]
        },
        "dependencies": {
          "$ref": "#/$defs/id_list"
        },
        "finding_ids": {
          "$ref": "#/$defs/id_list"
        },
        "decision_ids": {
          "$ref": "#/$defs/id_list"
        },
        "authority_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptance_entry"
          }
        },
        "compatibility_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "non_effects": {
          "$ref": "#/$defs/reference_list"
        },
        "lifecycle": {
          "enum": [
            "pending",
            "ready",
            "active",
            "blocked",
            "stale",
            "complete"
          ]
        },
        "implementation_status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "blocker": {
          "$ref": "#/$defs/nullable_blocker"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "reviewer",
        "checkpoint",
        "scope",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "lens": {
          "$ref": "#/$defs/short_string"
        },
        "status": {
          "enum": [
            "pending",
            "findings",
            "clean"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 240
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "evidence_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "scope": {
          "$ref": "#/$defs/short_string"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_status",
        "implementation_status",
        "compatibility",
        "evidence_refs",
        "checkpoint"
      ],
      "properties": {
        "model_status": {
          "enum": [
            "not evaluated",
            "unchanged",
            "accepted",
            "conflicting"
          ]
        },
        "implementation_status": {
          "$ref": "#/$defs/status"
        },
        "compatibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "evidence_refs": {
          "$ref": "#/$defs/reference_list"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "acceptance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wrong_behavior",
        "evidence_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]{1,3}$"
        },
        "wrong_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "evidence_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    }
  }
}
